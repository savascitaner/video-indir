# Kestirmenin sunucuya erişmek için kullanacağı gizli anahtar. Uzun ve rastgele bir şey yaz.
API_KEY=buraya-uzun-rastgele-bir-anahtar-yaz
# İsteğe bağlı: giriş gerektiren videolar için Netscape biçiminde çerez dosyası
COOKIES_FILE=
# İsteğe bağlı: bu süreden (saniye) uzun videoları reddet. 0 = sınırsız
MAX_SURE=0
# Güncelleme kontrolü için: repo gizliyse, yalnızca bu repoyu okuyabilen bir GitHub erişim anahtarı
# (github.com/settings/personal-access-tokens → Fine-grained → Contents: Read-only)
GITHUB_TOKEN=
